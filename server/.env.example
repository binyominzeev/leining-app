# Copy to server/.env and configure the Pocket ID client.
PORT=3001
DATA_DIR=./data
OIDC_ISSUER=https://auth.binjomin.hu
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must exactly match the Pocket ID registered URI and the frontend origin + "/".
OIDC_REDIRECT_URI=http://localhost:5173/
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# Optional audience required in access tokens.
OIDC_AUDIENCE=
